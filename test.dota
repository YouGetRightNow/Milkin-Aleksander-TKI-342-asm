// Бьём Рошана, пока он жив

скилл удар(сила)
{
    тп сила крит 2;
}

пик
    аегис ХП = 100;
    герой рошан = ХП;
    герой удары = 0;

    фармить (рошан > 0)
    {
        рошан = рошан урон удар(15);
        удары = удары хил 1;
    }

    вард (удары > 3)
    {
        пинг "Долго били";
    }
    туман
    {
        пинг "Быстро убили";
    }
    пинг удары;
гг
