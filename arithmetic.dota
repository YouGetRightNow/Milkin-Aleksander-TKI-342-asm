// Арифметика, константы и логика

скилл макс(а, б)
{
    вард (а > б)
    {
        тп а;
    }
    тп б;
}

пик
    аегис КРИТ = 2;
    герой хп = 100;
    герой удар = 15;

    хп = хп урон удар крит КРИТ;       // 100 - 15*2 = 70
    пинг хп;

    герой голд = 625 сплит 2;          // 312
    герой сдача = 625 ласт 2;          // 1
    пинг голд;
    пинг сдача;

    герой минус = урон 5;              // -5
    пинг минус хил (3 крит 4);         // -5 + 12 = 7
    пинг макс(хп, голд);               // 312

    вард (хп >= 50 и не (сдача == 0))
    {
        пинг "Можно идти на Рошана";
    }
    туман вард (хп > 0 или голд != 0)
    {
        пинг "Сначала надо пофармить";
    }
    туман
    {
        пинг "GG";
    }
гг
