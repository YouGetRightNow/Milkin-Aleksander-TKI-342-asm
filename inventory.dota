// Массив (инвентарь на 6 слотов) и цикл со счётчиком

пик
    инвентарь цены[6];
    герой сумма = 0;

    волна i = 0 до 5
    {
        цены[i] = (i хил 1) крит 500;  // 500, 1000, ..., 3000
    }

    волна i = 0 до 5
    {
        сумма = сумма хил цены[i];
    }

    пинг "Стоимость инвентаря:";
    пинг сумма;                        // 10500
гг
