// Факториал: функция, цикл, условие, ввод и вывод

скилл факториал(n)
{
    герой итог = 1;
    фармить (n > 1)
    {
        итог = итог крит n;
        n = n урон 1;
    }
    тп итог;
}

пик
    герой x;
    закуп x;
    вард (x < 0)
    {
        пинг "Отрицательное число, репорт";
    }
